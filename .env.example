# NEW dedicated Browinfo project only. Never use the shared legacy DB.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NEW-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EXPECTED_SUPABASE_PROJECT_REF=YOUR-NEW-PROJECT-REF
# Create this user in Supabase Authentication > Users, then add the exact email here.
ADMIN_EMAILS=your-admin@example.com
SITE_VISIBILITY=private
PREVIEW_ACCESS_PASSWORD=
# Canonical HTTPS origin, no trailing slash. Configure after approved deployment.
APP_ORIGIN=
# No OpenAI/Claude API key or Vercel generation Cron is used.
# OAuth connection remains disabled until configured and tested.
CHATGPT_DRAFTS_ENABLED=false
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_REDIRECT_URI=
MCP_ADMIN_USER_ID=
# Pageviews only begin on public pages when enabled and this secret is >=32 chars.
ANALYTICS_ENABLED=false
ANALYTICS_SECRET=
