# NEW, dedicated Browinfo Supabase project. Never point at a shared legacy DB.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NEW-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
EXPECTED_SUPABASE_PROJECT_REF=YOUR-NEW-PROJECT-REF
# Supabase Auth users explicitly authorized as editors; public sign-up is unnecessary.
ADMIN_EMAILS=your-admin@example.com
# Default is private. Public release requires explicit user approval.
SITE_VISIBILITY=private
# At least 16 random characters. Basic Auth username may be any nonempty name.
PREVIEW_ACCESS_PASSWORD=
# Generating content incurs LLM API charges. Disabled until explicitly configured.
AI_GENERATION_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
MAX_ARTICLES_PER_RUN=2
# At least 32 random characters. Cron is disabled in vercel.json by default.
CRON_SECRET=
# Optional official RSS feeds. URLs must pass the allowlist in lib/sources.ts.
# SOURCE_FEEDS=[{"url":"https://blog.cloudflare.com/rss/","publisher":"Cloudflare","category":"IT·AI"}]
